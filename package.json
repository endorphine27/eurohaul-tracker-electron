{
  "name": "eurohaul-tracker",
  "version": "1.0.0",
  "description": "EuroHaul Tracker - Electron, integral (fara Python)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "trucksim-telemetry": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "eu.eurohaul.tracker",
    "productName": "EuroHaul Tracker",
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "sounds", "to": "sounds", "filter": ["**/*"] }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
